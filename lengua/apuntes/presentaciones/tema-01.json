 "conceptos": [
  {
   "tipo": "comparacion",
   "titulo": "Estilo directo e indirecto",
   "items": [
    {
     "etiqueta": "Directo",
     "texto": "Se mantienen las palabras originales.",
     "ejemplo": "Cristina le dijo “trae el pan”."
    },
    {
     "etiqueta": "Indirecto",
     "texto": "Se cuenta lo que una persona ha dicho.",
     "ejemplo": "Cristina le dijo a su hija que trajera el pan."
    }
   ]
  },
  {
   "tipo": "definiciones",
   "titulo": "Agudas, llanas y esdrújulas",
   "items": [
    {
     "t": "Agudas",
     "d": "La sílaba que suena más fuerte es la última.",
     "regla": "Llevan tilde cuando terminan en vocal, N o S."
    },
    {
     "t": "Llanas",
     "d": "La sílaba que suena más fuerte es la penúltima.",
     "regla": "Llevan tilde cuando no terminan en vocal, N o S."
    },
    {
     "t": "Esdrújulas",
     "d": "La sílaba que suena más fuerte es la antepenúltima.",
     "regla": "Siempre llevan tilde."
    }
   ]
  },
  {
   "tipo": "comparacion",
   "titulo": "Vocales abiertas y cerradas",
   "items": [
    {
     "etiqueta": "Abiertas",
     "grande": "A · E · O"
    },
    {
     "etiqueta": "Cerradas",
     "grande": "I · U"
    }
   ]
  },
  {
   "tipo": "regla",
   "titulo": "Diptongos",
   "enunciado": "Es la unión de 2 vocales en una misma sílaba.",
   "puntos": [
    "Vocal cerrada + vocal cerrada",
    "Vocal abierta + vocal cerrada",
    "Vocal cerrada + vocal abierta"
   ],
   "chips": [
    "huésped",
    "murciélago"
   ]
  },
  {
   "tipo": "regla",
   "titulo": "Triptongos",
   "enunciado": "Es la unión de 3 vocales en una misma sílaba.",
   "puntos": [
    "Vocal cerrada + vocal abierta + vocal cerrada"
   ],
   "chips": [
    "fastidiéis"
   ]
  },
  {
   "tipo": "regla",
   "titulo": "Hiatos",
   "enunciado": "Es la separación en 2 sílabas distintas de 2 vocales que se escriben juntas.",
   "puntos": [
    "Vocal abierta + vocal abierta (teatro, leemos)",
    "Vocal abierta + vocal cerrada"
   ],
   "nota": "Si la vocal tónica es la cerrada, siempre lleva tilde.",
   "chips": [
    "fría",
    "río",
    "reír"
   ]
  },
  {
   "tipo": "tabla",
   "titulo": "La tilde diacrítica",
