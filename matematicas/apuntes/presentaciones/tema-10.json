  {
   "titulo": "Gráfica de barras",
   "formulas": [
    "\\text{Total}=\\text{suma de todos los datos}",
    "p=\\dfrac{c}{t}\\times100"
   ],
   "explicacion": "Sirve para comparar categorías: la altura de cada barra es la cantidad. Para saber qué parte del total es una barra, divide entre el total."
  },
  {
   "titulo": "Gráfica de sectores",
   "formulas": [
    "p=\\dfrac{c}{t}\\times100",
    "\\sum p_i=100\\,\\%"
   ],
   "explicacion": "Muestra las partes de un total. Los porcentajes de todos los sectores deben sumar el 100 %."
  },
  {
   "titulo": "Gráfica de líneas",
   "formulas": [
    "V_A=C_f-C_i",
    "V_P=\\dfrac{V_A}{C_i}\\times100"
   ],
   "explicacion": "Muestra cómo evoluciona una cantidad en el tiempo. La variación absoluta es la diferencia y la porcentual la compara con el valor inicial."
  },
  {
   "titulo": "Elegir el gráfico adecuado",
   "formulas": [
    "\\text{comparar}\\to\\text{barras}",
    "\\text{partes de un total}\\to\\text{sectores}",
    "\\text{evolución}\\to\\text{líneas}"
   ],
   "explicacion": "Elige el gráfico según lo que quieras mostrar."
