 "formulas": [
  {
   "titulo": "Regla de tres directa",
   "formulas": [
    "\\dfrac{a}{b}=\\dfrac{c}{x}\\;\\Rightarrow\\;x=\\dfrac{b\\cdot c}{a}"
   ],
   "explicacion": "Si una magnitud sube, la otra sube en la misma proporción. Multiplica en cruz y divide entre el dato que queda solo."
  },
  {
   "titulo": "Regla de tres inversa",
   "formulas": [
    "a\\cdot b=c\\cdot x\\;\\Rightarrow\\;x=\\dfrac{a\\cdot b}{c}"
   ],
   "explicacion": "Si una magnitud sube, la otra baja. El producto de cada pareja es el mismo: multiplica los datos conocidos y divide entre el tercero."
  },
  {
   "titulo": "Constante en la directa",
   "formulas": [
    "k=\\dfrac{y}{x}"
   ],
   "explicacion": "En la proporcionalidad directa el cociente y/x es siempre el mismo. Ese valor es la constante de proporcionalidad."
  },
  {
   "titulo": "Constante en la inversa",
   "formulas": [
    "k=x\\cdot y"
   ],
   "explicacion": "En la proporcionalidad inversa el producto x·y es siempre el mismo. Si no se mantiene, no es inversa."
  }
 ],
