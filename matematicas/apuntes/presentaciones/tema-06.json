  {
   "titulo": "Capital final con interés compuesto",
   "formulas": [
    "C_f=C_i\\cdot(1+\\text{tasa})^{\\text{años}}"
   ],
   "explicacion": "Cada año se multiplica el capital por (1 + tasa), con la tasa en tanto por uno. Los intereses se suman al capital y el año siguiente también generan intereses."
  },
  {
   "titulo": "Interés ganado",
   "formulas": [
    "I=C_f-C_i"
   ],
   "explicacion": "El interés total es lo que has ganado: capital final menos capital inicial."
  },
  {
   "titulo": "Despejar el capital inicial",
   "formulas": [
    "C_i=\\dfrac{C_f}{(1+\\text{tasa})^{\\text{años}}}"
   ],
   "explicacion": "Si conoces el capital final, divídelo entre (1 + tasa) elevado a los años."
  },
  {
   "titulo": "Pasar meses a años",
   "formulas": [
    "\\text{años}=\\dfrac{\\text{meses}}{12}"
   ],
   "explicacion": "Si el tiempo viene en meses, divide entre 12. Por ejemplo, 18 meses son 1,5 años."
  }
 ],
