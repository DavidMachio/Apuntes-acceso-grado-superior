 "formulas": [
  {
   "titulo": "Qué porcentaje es una parte del total",
   "formulas": [
    "p=\\dfrac{c}{t}\\times100"
   ],
   "explicacion": "Divide la cantidad (c) entre el total (t) y multiplica por 100. El resultado te dice qué parte del total es, expresada en %."
  },
  {
   "titulo": "Calcular la parte a partir del %",
   "formulas": [
    "c=t\\cdot\\dfrac{p}{100}"
   ],
   "explicacion": "Si conoces el total y el porcentaje, multiplica el total por p/100 para obtener la parte."
  },
  {
   "titulo": "Calcular el total",
   "formulas": [
    "t=\\dfrac{c\\cdot100}{p}"
   ],
   "explicacion": "Si conoces la parte y el porcentaje que representa, multiplica la parte por 100 y divide entre el porcentaje."
  },
  {
   "titulo": "Con regla de tres",
   "formulas": [
    "\\dfrac{c}{t}=\\dfrac{p}{100}"
   ],
   "explicacion": "Las tres fórmulas salen de esta proporción. Recuerda: una parte nunca supera el total, así que el porcentaje no pasa del 100 %."
  }
 ],
