  {
   "titulo": "Frecuencia absoluta",
   "formulas": [
    "FA=\\text{veces que aparece el dato}"
   ],
   "explicacion": "Cuenta cuántas veces aparece cada dato. Las frecuencias absolutas suman el total de datos."
  },
  {
   "titulo": "Frecuencia relativa",
   "formulas": [
    "FR=\\dfrac{FA}{n}"
   ],
   "explicacion": "Divide la frecuencia absoluta entre el número total de datos. Es un número entre 0 y 1."
  },
  {
   "titulo": "Porcentaje",
   "formulas": [
    "P=FR\\times100"
   ],
   "explicacion": "Multiplica la frecuencia relativa por 100 para expresarla como porcentaje."
  },
  {
   "titulo": "Comprobar las sumas",
   "formulas": [
    "\\sum FR=1\\qquad\\sum FA=n"
   ],
   "explicacion": "Si las frecuencias relativas no suman 1 (o los porcentajes 100 %), revisa tus cuentas."
  }
 ],
