 "formulas": [
  {
   "titulo": "Lo que suma pasa restando",
   "formulas": [
    "x+a=b\\;\\Rightarrow\\;x=b-a"
   ],
   "explicacion": "Para dejar la incógnita sola, pasa al otro lado lo que está sumando, pero restando."
  },
  {
   "titulo": "Lo que resta pasa sumando",
   "formulas": [
    "x-a=b\\;\\Rightarrow\\;x=b+a"
   ],
   "explicacion": "Lo que está restando pasa al otro lado sumando."
  },
  {
   "titulo": "Lo que multiplica pasa dividiendo",
   "formulas": [
    "a\\cdot x=b\\;\\Rightarrow\\;x=\\dfrac{b}{a}"
   ],
   "explicacion": "Lo que multiplica a la incógnita pasa al otro lado dividiendo."
  },
  {
   "titulo": "Lo que divide pasa multiplicando",
   "formulas": [
    "\\dfrac{x}{a}=b\\;\\Rightarrow\\;x=a\\cdot b"
   ],
   "explicacion": "Lo que divide a la incógnita pasa al otro lado multiplicando. Empieza siempre por las sumas y las restas."
  }
 ],
