  {
   "titulo": "Un porcentaje es una fracción de 100",
   "formulas": [
    "21\\,\\% = \\dfrac{21}{100} = 0{,}21"
   ],
   "explicacion": "El porcentaje indica cuántas partes de cada 100 tomamos. Para usarlo en una cuenta, se divide entre 100."
  },
  {
   "titulo": "Sumar o restar un porcentaje",
   "formulas": [
    "\\text{Final}=\\text{Inicial}\\left(1+\\dfrac{p}{100}\\right)",
    "\\text{Final}=\\text{Inicial}\\left(1-\\dfrac{p}{100}\\right)"
   ],
   "explicacion": "Para subir un 21 %, multiplica por 1,21; para bajar un 15 %, multiplica por 0,85. El porcentaje se calcula siempre sobre la cantidad inicial."
  },
  {
   "titulo": "Deshacer una subida: divide",
   "formulas": [
    "\\text{Inicial}=\\dfrac{\\text{Final}}{1+\\dfrac{p}{100}}"
   ],
   "explicacion": "Para volver al precio sin IVA, divide entre 1,21. Si el IVA no fuera del 21 %, cambia 1,21 por 1 + p/100."
  }
 ],
