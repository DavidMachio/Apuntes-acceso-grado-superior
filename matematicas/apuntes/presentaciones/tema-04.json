 "formulas": [
  {
   "titulo": "Variación absoluta",
   "formulas": [
    "V_A=C_f-C_i"
   ],
   "explicacion": "Cuánto ha cambiado una cantidad en unidades: valor final menos valor inicial. Es positiva si sube y negativa si baja."
  },
  {
   "titulo": "Variación porcentual",
   "formulas": [
    "V_P=\\dfrac{V_A}{C_i}\\times100"
   ],
   "explicacion": "Cuánto ha cambiado en proporción a lo que había al principio: divide la variación absoluta entre la cantidad inicial y multiplica por 100."
  },
  {
   "titulo": "El signo indica si sube o baja",
   "formulas": [
    "C_f>C_i\\Rightarrow V>0",
    "C_f<C_i\\Rightarrow V<0"
   ],
   "explicacion": "Si el valor final es mayor que el inicial, la variación es positiva. Si es menor, es negativa."
  },
  {
   "titulo": "Siempre se divide entre el valor de partida",
   "formulas": [
    "V_P=\\dfrac{C_f-C_i}{C_i}\\times100"
   ],
   "explicacion": "El denominador es siempre la cantidad inicial, la de partida, nunca la final."
  }
 ],
